// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User/Profile table
model Profile {
  id          String   @id @default(cuid())
  email       String   @unique
  fullName    String   @map("full_name")
  password    String
  role        Role     @default(AGENT)
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   Profile? @relation("CreatedByProfile", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers Profile[] @relation("CreatedByProfile")
  savingsCards SavingsCard[]
  deposits    Deposit[]
  withdrawalRequests WithdrawalRequest[]
  ClientSavingsCards SavingsCard[] @relation("ClientSavingsCards")

  @@map("profiles")
}

enum Role {
  ADMIN
  AGENT
  CLIENT
}

// Savings cards
model SavingsCard {
  id           String                              @id @default(cuid())
  clientId     String                              @map("client_id")
  name         String
  dailyAmount  Decimal                             @map("daily_amount") @db.Decimal(12, 2)
  currency     Currency                            @default(CDF)
  totalDays    Int                                 @map("total_days")
  daysCovered  Int                                 @default(0) @map("days_covered")
  totalSaved   Decimal                             @default(0) @map("total_saved") @db.Decimal(12, 2)
  status       SavingsCardStatus                   @default(ACTIVE)
  createdById  String?                             @map("created_by")
  createdAt    DateTime                            @default(now()) @map("created_at")
  updatedAt    DateTime                            @updatedAt @map("updated_at")
  client       Profile                             @relation("ClientSavingsCards", fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    Profile?                             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deposits     Deposit[]
  withdrawalRequests WithdrawalRequest[]

  @@map("savings_cards")
}

enum Currency {
  CDF
  USD
}

enum SavingsCardStatus {
  ACTIVE
  COMPLETED
  WITHDRAWAL_REQUESTED
  WITHDRAWN
}

// Daily deposits (mises)
model Deposit {
  id          String          @id @default(cuid())
  cardId      String          @map("card_id")
  amount      Decimal         @db.Decimal(12, 2)
  depositDate DateTime        @map("deposit_date")
  status      DepositStatus   @default(COMPLETED)
  notes       String?
  createdById String?          @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  card        SavingsCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdBy   Profile?         @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("deposits")
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
}

// Withdrawal requests
model WithdrawalRequest {
  id          String          @id @default(cuid())
  cardId      String          @map("card_id")
  requestedById String?       @map("requested_by")
  amount      Decimal         @db.Decimal(12, 2)
  status      WithdrawalStatus @default(PENDING)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  card        SavingsCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  requestedBy Profile?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@map("withdrawal_requests")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}
